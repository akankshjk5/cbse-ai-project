# GPU worker environment (RunPod Pod side) — variable names only.
#
# These are NOT read by the Next.js app; they are set as Pod environment
# variables, or uploaded as .runpod-worker.env by scripts/connect-runpod.ps1
# (that file holds the real service-role key and is gitignored, never committed).
#
# Copy to .runpod-worker.env locally and fill in. Required variables have no
# default: media_worker.py exits with a named error if one is missing.

# ── Required ────────────────────────────────────────────────────────────────
SUPABASE_URL=
# Bypasses RLS entirely. Pod-side only; never ship to a browser or a client.
SUPABASE_SERVICE_ROLE_KEY=

# ── ComfyUI and paths ───────────────────────────────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
WORKSPACE=/workspace
MEDIA_WORKFLOW_DIR=/workspace/lumina-deck-pro/ops/runpod/workflows/api
COMFYUI_INPUT_DIR=/workspace/ComfyUI/input
COMFYUI_OUTPUT_DIR=/workspace/ComfyUI/output
MEDIA_OUTPUT_DIR=/workspace/lumina-media-output
LESSON_FONTS_DIR=/workspace/lumina-fonts

# ── Worker identity and limits ──────────────────────────────────────────────
# Defaults to runpod-<random> when unset.
MEDIA_WORKER_ID=
MEDIA_JOB_TIMEOUT_SECONDS=1800
# Health endpoint the app probes via LOCAL_VIDEO_WORKER_URL.
MEDIA_HEALTH_PORT=8090

# ── SSRF allowlist ──────────────────────────────────────────────────────────
# Extra hosts the worker may download source images from, comma separated.
# The SUPABASE_URL host is always allowed; everything else is refused.
MEDIA_SOURCE_HOSTS=

# ── Render policy ───────────────────────────────────────────────────────────
# wan = generative image-to-video (about 48 s per clip on an RTX 6000 Ada).
# stable = deterministic Ken Burns over the approved still (CPU, seconds).
LESSON_VIDEO_MOTION_MODE=wan
# generated = Z-Image Turbo. fact-card = render the audited fact as text.
LESSON_IMAGE_MODE=generated
# editorial = wrap the clip in the deterministic compositor scene.
LESSON_COMPOSITE_MODE=editorial
# 30 is the benchmarked fallback; 20 is the ComfyUI native fast target.
WAN_FAST_STEPS=30

# ── Local model paths (hydrated onto NVMe before ComfyUI binds its port) ────
LOCAL_PLANNER_MODEL_PATH=/workspace/lumina-local-ai/qwen3-4b
LOCAL_TTS_MODEL_PATH=/workspace/lumina-local-ai/indic-parler-tts
LOCAL_ASR_MODEL_PATH=/workspace/lumina-local-ai/whisper-large-v3-turbo
PLANNER_MODEL=

# ── Provisioning (bootstrap.sh, hydrate_models.sh, start_comfyui.sh) ────────
RUNPOD_WORKSPACE_ROOT=/root/lumina-runtime
RUNPOD_MODEL_STORE_ROOT=/workspace
RUNPOD_HYDRATE_PROFILE=baseline
