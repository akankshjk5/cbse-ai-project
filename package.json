{
  "name": "lumina-deck-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --require ./scripts/allow-server-only.cjs scripts/smoke-agent.mts",
    "smoke:render": "tsx --require ./scripts/allow-server-only.cjs scripts/smoke-render.mts",
    "smoke:browser-layout": "tsx --require ./scripts/allow-server-only.cjs scripts/smoke-browser-layout.mts",
    "smoke:research": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/smoke-research.mts",
    "smoke:deck": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/smoke-deck.mts",
    "smoke:cloud-skills": "tsx --require ./scripts/allow-server-only.cjs scripts/smoke-cloud-lesson-skills.mts",
    "test:cloud-gemini": "tsx --require ./scripts/allow-server-only.cjs scripts/test-cloud-lesson-gemini.mts",
    "smoke:cloud-gemini": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/smoke-cloud-gemini.mts",
    "test:cloud-prepare": "tsx --require ./scripts/allow-server-only.cjs scripts/test-cloud-prepare.mts",
    "worker:cloud-prepare": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/cloud-lesson-worker.mts --kinds prepare",
    "smoke:cloud-prepare": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/smoke-cloud-prepare.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "worker:cloud-image": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/cloud-lesson-worker.mts --kinds image",
    "test:cloud-image": "tsx --require ./scripts/allow-server-only.cjs scripts/test-cloud-image.mts",
    "worker:cloud-media": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/cloud-media-worker.mts",
    "test:cloud-media": "tsx --require ./scripts/allow-server-only.cjs scripts/test-cloud-media.mts",
    "test:cloud-ui": "tsx --require ./scripts/allow-server-only.cjs scripts/test-cloud-ui.mts",
    "test:cloud-storybook": "tsx --require ./scripts/allow-server-only.cjs scripts/test-cloud-storybook.mts",
    "smoke:cloud-storybook": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/smoke-cloud-storybook.mts",
    "report:cloud-lesson": "tsx --env-file=.env --require ./scripts/allow-server-only.cjs scripts/report-cloud-lesson.mts",
    "test:providers": "tsx --require ./scripts/allow-server-only.cjs scripts/test-generation-providers.mts",
    "test:reuse": "tsx --require ./scripts/allow-server-only.cjs scripts/test-reuse-and-cost.mts",
    "test:enforcement": "tsx --require ./scripts/allow-server-only.cjs scripts/test-provider-enforcement.mts",
    "catalogue:ktbs": "tsx --require ./scripts/allow-server-only.cjs scripts/ingest-ktbs-catalogue.mts",
    "test:ktbs": "tsx --require ./scripts/allow-server-only.cjs scripts/test-ktbs-catalogue.mts",
    "doctor": "tsx scripts/doctor.mts",
    "test:lesson-spec": "tsx scripts/test-lesson-spec.mts",
    "test:db": "node scripts/db-test.mjs",
    "server:check": "python ops/cloud/check_server.py",
    "sample:lesson": "python ops/cloud/make_sample.py",
    "test:outputs": "tsx scripts/test-outputs.mts",
    "test:asset-store": "tsx scripts/test-asset-store.mts",
    "test:asset-url": "tsx --require ./scripts/allow-server-only.cjs scripts/test-asset-url.mts",
    "bench:lesson": "python ops/cloud/benchmark.py",
    "deck:original": "tsx --require ./scripts/allow-server-only.cjs scripts/make-original-deck.mts",
    "test:image-provider": "tsx --require ./scripts/allow-server-only.cjs scripts/test-image-provider.mts",
    "test:local-image": "tsx --require ./scripts/allow-server-only.cjs scripts/test-local-image-contract.mts",
    "test:lesson-deck": "tsx --require ./scripts/allow-server-only.cjs scripts/test-lesson-deck.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.2",
    "@clerk/ui": "^1.30.8",
    "@google/genai": "^2.24.0",
    "@openrouter/agent": "^0.11.0",
    "@openrouter/sdk": "^1.2.80",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.12.2",
    "next": "16.3.3",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jszip": "^3.10.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
