# Copy to .env and fill in. `.env*` is gitignored — never commit real values.
# On Vercel, prefer `vercel env pull` over hand-editing this.
#
# `.env` rather than `.env.local`: the smoke scripts run outside Next, through
# tsx with `--env-file=.env`, and read nothing Next would have loaded for them.
#
# Every variable below is read in exactly one place — src/lib/env.ts — and a
# missing required one throws by name at first use rather than failing later as
# an unrelated network error. Anything without a value here has no default and
# the app will not start without it.

# ── Models ───────────────────────────────────────────────────────────────────
# Fallback text model, for a skill that declares no `model:` of its own. Every
# specialist does declare one, so this is a safety net — but it must still be a
# reasoning model, because the pipeline asks for reasoning on every call.
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Optional comma-separated server-side fallbacks.
# OPENROUTER_FALLBACK_MODELS=
# Vision model. Reads the style reference image and returns the StyleSpec JSON
# — the only stage that sees the image. Must be vision-capable.
OPENROUTER_VISION_MODEL=google/gemini-3.6-flash
# Image generation. Must be an image-OUTPUT model, not merely vision-capable.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# Set to `off` to skip illustration generation entirely. This is the real cost
# switch: illustration is ~90% of a deck's bill, the whole text pipeline ~1.5c.
OPENROUTER_IMAGE_TIER=on
# How far generated images are pulled into the deck's palette, 0-1. Image models
# ignore a palette the moment the subject has a conventional colour (a pond is
# green however firmly you forbid it), and one stray hue across a deck is what a
# viewer notices first. 0.7 removes it while keeping form and shading; 0 is off.
OPENROUTER_IMAGE_PALETTE=0.7
# The visual review: renders every slide and asks a vision model what looks
# wrong with the deck. One call, ~$0.003, and the only check in the pipeline
# that can fail for a reason nobody wrote a rule for. `off` skips it.
OPENROUTER_VISUAL_REVIEW=on

# ── Reasoning ────────────────────────────────────────────────────────────────
# How hard every specialist thinks: minimal | low | medium | high.
# The pipeline is a chain of judgements, and the terminal trace (the `~` lines)
# is the model's own argument for each one — so `minimal` both degrades the deck
# and empties the log you would debug it with. Use it to compare cost, not to
# run builds you intend to inspect.
OPENROUTER_REASONING_EFFORT=medium

# ── Research / web search ────────────────────────────────────────────────────
# The Researcher runs with live search attached when no documents are supplied.
# The search is billed through the same OpenRouter call, so there is no separate
# search API key.
#
# `native` asks the provider to use its own grounding — on a Gemini model that
# is Google Search — and OpenRouter falls back to its own engine for providers
# that have none. Alternatives: exa | firecrawl | parallel | perplexity.
OPENROUTER_SEARCH_ENGINE=native
OPENROUTER_SEARCH_MAX_RESULTS=8
# `off` forbids the Researcher from reaching the web. Decks then rely on the
# Documents/ drop folder and the model's own knowledge.
OPENROUTER_SEARCH_TIER=on

# Per-skill overrides, for when a provider retires a slug — or when you want to
# spend more on one stage. The skill's own `model:` frontmatter is the default;
# this wins over it.
#
# The shipped lineup is deliberately cheap. Every specialist runs on a small
# reasoning model, because the work here is structured judgement over a short
# context rather than open-ended generation, and the frontier models were
# costing 40x the output rate for a deck that read the same. If one stage
# consistently disappoints, raise that stage — not the whole pipeline.
# OPENROUTER_MODEL_RESEARCHER=google/gemini-3.6-flash
# OPENROUTER_MODEL_SLIDE_DESIGNER=z-ai/glm-5.3-flash

# Embeddings. MUST produce 1536 dimensions to match the vector(1536) column in
# supabase/migrations/20260827000500_rag.sql. Changing it invalidates every
# stored vector — see that migration's header before you touch this.
# Reserved for the pgvector RAG path. `src/lib/env.ts` declares these, and
# GENAI_API_KEY / GOOGLE_CLOUD_PROJECT are marked required there, but NO code
# currently reads any of them: the documents/document_chunks tables exist and
# nothing queries them. Leave blank until the ingest path is wired up.
GENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GENAI_EMBED_MODEL=gemini-embedding-001

# ── Layout engine ────────────────────────────────────────────────────────────
# `code` (default): geometry and type sizing come from the Manager's own passes
# — applyLayouts / growTextBoxes / fitToCanvas / fitTypeToBoxes / compactTitleBand.
# `browser`: Agents/pptx/browser-layout.ts renders the real SlideCanvas in a
# headless Chromium and measures it instead. Kept behind a switch while that
# migration is in progress; `code` is the rollback path.
LAYOUT_ENGINE=code

# ── Keys ─────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Google AI Studio, for the RAG corpus. Declared in src/lib/env.ts but not
# reached yet: the `documents` / `document_chunks` tables and the vector(1536)
# column exist, and nothing embeds anything into them. `required()` only throws
# at first use, so leaving this empty costs nothing today. Fill it in when the
# ingest path lands.
# GENAI_API_KEY=
# Narrated Video uses local RunPod models for planning, Indian-language
# translation, and speech. During localhost development, forward these loopback ports over SSH:
#   ssh -N -L 18080:127.0.0.1:18080 -L 18081:127.0.0.1:18081 -L 18082:127.0.0.1:18082 #          -L 8188:127.0.0.1:8188 -L 8090:127.0.0.1:8090 ...
# `scripts/connect-runpod.ps1` opens exactly these five forwards.
# The app rejects non-loopback URLs so these inference services are never
# accidentally exposed as unauthenticated public endpoints.
#
# All five are checked by assertLocalVideoServicesReady() before a lesson is
# reserved; a missing one refuses the request with 503 rather than queueing
# work no worker can claim.
LOCAL_VIDEO_AGENT_URL=http://127.0.0.1:18080
LOCAL_VIDEO_TTS_URL=http://127.0.0.1:18081
LOCAL_VIDEO_TRANSLATION_URL=http://127.0.0.1:18082
# ComfyUI (image + video generation) and the media worker's health endpoint.
LOCAL_VIDEO_COMFY_URL=http://127.0.0.1:8188
LOCAL_VIDEO_WORKER_URL=http://127.0.0.1:8090
# Not read by any code yet. `deck_assets.source` reserves 'unsplash' and
# 'youtube' for stock imagery and embeds, and the attribution column exists for
# their terms — but nothing fetches from either provider today. Leave them out
# of your .env until something does; a key that is set but unused only looks
# like a dependency.
# UNSPLASH_ACCESS_KEY=
# YOUTUBE_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# RunPod worker only. Set this on the Pod alongside the service-role key; the
# Next.js app uses NEXT_PUBLIC_SUPABASE_URL above instead.
SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Clerk (authentication) ───────────────────────────────────────────────────
# Written by `clerk init` / `clerk env pull`. Do not hand-edit; re-pull instead.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Clerk webhooks ───────────────────────────────────────────────────────────
# Signing secret for the endpoint at /api/webhooks/clerk (Clerk dashboard ->
# Webhooks -> your endpoint -> Signing Secret). `verifyWebhook` reads it by
# name, and without it every delivery is rejected as unsigned.
#
# The endpoint must be subscribed to `user.created` and `user.deleted`.
# `user.deleted` is the one that matters: once a Clerk user is gone there is no
# session left to delete their decks with, so without it an erased account's
# decks, research and generated art stay in Postgres and in three storage
# buckets indefinitely.
#
# Local testing: clerk webhooks listen --token "$(clerk webhooks token)" \
#   --forward-to http://localhost:3000/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Clerk <-> Supabase ───────────────────────────────────────────────────────
# Supabase must be configured with Clerk as a third-party auth provider, using
# this domain (Supabase dashboard: Authentication -> Third Party Auth; local:
# supabase/config.toml). Without it, every RLS policy sees an unverified token
# and denies the request.
CLERK_INSTANCE_DOMAIN=your-instance.clerk.accounts.dev

# ── Clerk routing ────────────────────────────────────────────────────────────
# Use the in-app sign-in/sign-up routes instead of Clerk's hosted Account
# Portal, and land on /app afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── Cloud lesson engine (Gemini + Higgsfield) ───────────────────────────────
# A separate lesson engine from the RunPod one above; nothing here affects it.
# One Gemini key covers every call: text, speech, keyframe images and the
# keyframe check. Use EITHER service — the models are the same:
#   GEMINI_API_KEY        Google AI Studio key (starts AIza), from
#                         https://aistudio.google.com/apikey — not the
#                         gen-lang-client-… project id. Billing must be on.
#   GOOGLE_VERTEX_API_KEY Vertex AI express-mode key (starts AQ.); needs the
#                         Vertex AI API enabled on its project.
# AI Studio is used when GEMINI_API_KEY is set; force one with
# CLOUD_LESSON_GEMINI_BACKEND=aistudio|vertex.
GEMINI_API_KEY=
GOOGLE_VERTEX_API_KEY=
# CLOUD_LESSON_GEMINI_BACKEND=
# Speech model and voice. `npm run smoke:cloud-gemini` reports which model name
# your key accepts. GEMINI_TTS_MODEL (the other engine's) is NOT used here:
# Gemini 2.5 models are closed to new Gemini accounts.
# CLOUD_LESSON_TTS_MODEL=gemini-3.8-flash-tts
# CLOUD_LESSON_TTS_VOICE=Kore
# Keyframe images (scene 1, then scenes 2-8 in scene 1's style).
# CLOUD_LESSON_IMAGE_MODEL=gemini-nano-banana-2.1
# Gemini calls one worker process may have in flight (default 8).
# CLOUD_LESSON_GEMINI_CONCURRENCY=8
# Per-skill model override, e.g. a stronger scene director:
# CLOUD_LESSON_MODEL_CLOUD_LESSON_SCENE_DIRECTOR=gemini/gemini-3.8-flash

# Cloud media worker (Step 6). Keep these server-only.
# Higgsfield API credentials: KEY_ID:KEY_SECRET, separate from website plans.
HF_CREDENTIALS=
# HF_KEY or existing HIGGSFIELD is also accepted; or HF_API_KEY_ID + HF_API_KEY_SECRET.
# Estimate for Kling 2.5 Turbo Pro; verify the current account rate/promotion.
# CLOUD_LESSON_HIGGSFIELD_USD_PER_SECOND=0.035
# CPU compositor dependencies. Use absolute paths when not on PATH.
# CLOUD_LESSON_PYTHON=python
# CLOUD_LESSON_FFMPEG=ffmpeg
# CLOUD_LESSON_FFPROBE=ffprobe
# CLOUD_LESSON_FONTS_DIR=ops/cloud/fonts
# Storybook only: a folder of background music you have the rights to (.wav or .m4a).
# One track is picked per lesson and ducked under the narration. Unset = no music.
# CLOUD_LESSON_MUSIC_DIR=ops/cloud/music
# Allowlisted provider CDN domains (exact host or subdomain, no redirects).
# CLOUD_LESSON_PROVIDER_MEDIA_HOSTS=higgsfield.ai,higgs.ai,cloudfront.net

# Step 7 Lesson Video UI: /app/cloud-lessons. No additional secrets needed.
# Run prepare, image and media workers separately; the UI only queues work.
# Existing Supabase/Clerk configuration protects the API and owner-scoped cache.

# =============================================================================
# Cloud lesson engine (src/lib/cloud-lesson/)
# =============================================================================
# The default generation provider. Gemini plans, narrates and draws; Higgsfield
# (Kling v2.5 Turbo Pro) animates the approved stills. Needs no GPU.

# Which engine serves a lesson: local | cloud | fixture.
# `local` is the default and the primary strategy: open models on GPU
# infrastructure we control. `cloud` routes to the paid Gemini/Higgsfield path
# — about nineteen times dearer per lesson, but needs no GPU to operate.
# `fixture` opens no job and spends nothing, for load tests. An unrecognised
# value refuses to boot rather than guessing.
LESSON_GENERATOR=local

# ── Paid provider policy (src/lib/generation/providers/policy.ts) ───────────
# Paid third-party APIs are optional, off by default, and NEVER selected as a
# fallback when a local service fails — a failure that silently becomes a bill
# is discovered at the end of the month; a failure that stops is discovered now.
#
# Two switches, because one switch gets flipped during an incident and never
# flipped back. Both are required before anything is billed.
ALLOW_EXTERNAL_PROVIDERS=false
# Comma-separated stages that may use a paid API: plan, image, speech, motion.
# Empty means none. A misspelled stage name refuses to boot.
EXTERNAL_PROVIDERS=

GEMINI_API_KEY=
# `api` uses GEMINI_API_KEY; `vertex` uses GOOGLE_CLOUD_PROJECT/LOCATION above.
CLOUD_LESSON_GEMINI_BACKEND=api
# Concurrent Gemini calls one worker may have in flight.
CLOUD_LESSON_GEMINI_CONCURRENCY=4
CLOUD_LESSON_IMAGE_MODEL=gemini-nano-banana-2.1
CLOUD_LESSON_TTS_MODEL=gemini-3.8-flash-tts
CLOUD_LESSON_TTS_VOICE=
GEMINI_TTS_VOICE=
# Per-skill model override, one per skill name upper-cased, e.g.
# CLOUD_LESSON_MODEL_CLOUD_LESSON_TRANSLATOR. Unset uses the skill's default.

# Higgsfield credentials. Either HF_CREDENTIALS (or HF_KEY / HIGGSFIELD) as one
# string, or the pair below, which is joined as "id:secret".
HF_CREDENTIALS=
# Accepted aliases for the same single-string credential.
HF_KEY=
HIGGSFIELD=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Estimate only; the account invoice stays authoritative. Drives the cost shown
# to a teacher and the crossover against the GPU path.
CLOUD_LESSON_HIGGSFIELD_USD_PER_SECOND=0.035
# Extra hosts the media worker may download provider output from, comma
# separated. Anything not listed is refused.
CLOUD_LESSON_PROVIDER_MEDIA_HOSTS=

# Local binaries and assets the media worker shells out to. It renders and
# assembles, so it must NOT run on a serverless function.
CLOUD_LESSON_PYTHON=python
CLOUD_LESSON_FFMPEG=ffmpeg
CLOUD_LESSON_FFPROBE=ffprobe
CLOUD_LESSON_FONTS_DIR=ops/cloud/fonts
CLOUD_LESSON_MUSIC_DIR=
